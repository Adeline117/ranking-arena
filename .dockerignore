# Git
.git
.gitignore

# Dependencies (will be installed in container)
node_modules
worker/node_modules

# Build outputs
.next
worker/dist

# Test files
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
coverage

# Development files + ALL env files (secrets must be mounted at runtime, never
# baked into an image layer — an rsync build context can include gitignored .env)
.env
.env.*
!.env.example
**/.env
**/.env.*
*.log

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Documentation (not needed in container)
docs
*.md
!README.md
!lib/logger/README.md

# Storybook
stories
.storybook

# E2E tests
e2e
playwright-report

# Repository-only inputs and independent deployment units. The ingest image's
# root-context COPY closure is intentionally limited to lib/** and worker/**;
# Actions computes the Worker release identity before invoking Docker. Keep these
# after the narrow README exception so no nested repository input is re-included.
/.claude
/.cursor
/.githooks
/.github
/android
/app
/appstore
/cloudflare-worker
/infra
/ios
/k6
/public
/scripts
/specs
/supabase
/vendor

# Other
.vercel
.turbo
.arena-ingest
backups
worker/logs
