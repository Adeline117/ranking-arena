\set ON_ERROR_STOP on

SELECT pg_catalog.set_config(
  'request.jwt.claim.role',
  'service_role',
  false
);
SELECT pg_catalog.set_config(
  'arena.stripe_livemode',
  'true',
  false
);

-- The shared authority harness keeps payment_history intentionally minimal;
-- restore the production FK so its ON DELETE SET NULL path is proven too.
ALTER TABLE public.payment_history
  ADD CONSTRAINT payment_history_user_id_fkey
  FOREIGN KEY (user_id)
  REFERENCES auth.users(id)
  ON DELETE SET NULL;

INSERT INTO auth.users(id) VALUES
