-- A failed observation legitimately predates its later successful payment.
INSERT INTO public.payment_history(
  user_id,
  stripe_invoice_id,
  stripe_payment_intent_id,
  amount,
  currency,
  status,
  created_at
) VALUES (
  'e7400000-0000-4000-8000-000000000001',
  'in_history_promote',
  NULL,
  999,
  'usd',
  'failed',
  '2029-01-01 00:00:00+00'
);

-- This unrelated audit identity proves a PaymentIntent collision cannot be
-- attached to a second Invoice.
INSERT INTO public.payment_history(
  user_id,
  stripe_payment_intent_id,
  amount,
  currency,
  status,
  created_at
) VALUES (
  'e7400000-0000-4000-8000-000000000001',
  'pi_history_collision',
  799,
  'usd',
  'abandoned',
  '2029-01-02 00:00:00+00'
);

-- Account deletion must redact the subject pointer without deleting or
