SELECT public.complete_tip_with_stripe_ownership_atomic(
  'e6200000-0000-4000-8000-000000000002',
  'cus_dispute_first_tip',
  'pi_dispute_first_tip',
  'ch_dispute_first_tip',
  'cs_dispute_first_tip',
  700,
  'usd',
  pg_catalog.clock_timestamp()
);

DO $prove_deferred_dispute_first_projection$
DECLARE
  v_readiness jsonb;
  v_claim jsonb;
BEGIN
  IF NOT EXISTS (
      SELECT 1
      FROM public.tips AS tip
      WHERE tip.id =
        'e6200000-0000-4000-8000-000000000002'
        AND tip.status = 'refunded'
    )
    OR NOT EXISTS (
      SELECT 1
      FROM public.stripe_charge_dispute_projections AS projection
      WHERE projection.livemode
        AND projection.stripe_event_id =
          'evt_dispute_first_tip'
        AND projection.product_kind = 'tip'
    )
  THEN
    RAISE EXCEPTION
      'dispute-first deferred ownership projection granted Tip';
  END IF;

  v_claim := public.claim_api_tier_reversal_actions_atomic(
    'e6400000-0000-4000-8000-000000000001',
    10,
    120,
    true
  );
  IF NOT EXISTS (
    SELECT 1
    FROM pg_catalog.jsonb_array_elements(v_claim) AS claimed(action)
    WHERE claimed.action ->> 'product_kind' = 'pro_entitlement'
      AND claimed.action ->> 'stripe_subscription_id' =
        'sub_dispute_pro'
  ) THEN
    RAISE EXCEPTION
      'Pro dispute cancellation claim lost product routing: %',
      v_claim;
  END IF;

  v_readiness := public.stripe_paid_launch_readiness_v2();
  IF NOT (
    v_readiness ? 'unprojected_charge_disputes'
    AND v_readiness ? 'charge_dispute_identity_anomalies'
    AND v_readiness ? 'charge_dispute_authority_drift'
  ) THEN
    RAISE EXCEPTION
      'Stripe dispute readiness keys are incomplete: %',
      v_readiness;
  END IF;
END
$prove_deferred_dispute_first_projection$;

\echo 'Stripe charge dispute authority fixture passed'
