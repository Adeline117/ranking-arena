DO $prove_reinstatement_first_convergence$
DECLARE
  v_readiness jsonb;
BEGIN
  IF NOT EXISTS (
      SELECT 1
      FROM public.tips AS tip
      JOIN public.tip_completion_notification_deliveries AS delivery
        ON delivery.tip_id = tip.id
      JOIN public.notifications AS notification
        ON notification.id = delivery.notification_id
      WHERE tip.id =
          'e6200000-0000-4000-8000-000000000003'
        AND tip.status = 'completed'
        AND delivery.disposition = 'delivered'
        AND notification.type = 'tip_received'
        AND notification.reference_id = tip.id
    )
    OR NOT EXISTS (
      SELECT 1
      FROM public.stripe_charge_dispute_projections AS projection
      WHERE projection.livemode
        AND projection.stripe_event_id =
          'evt_reinstatement_first_dispute'
    )
    OR NOT EXISTS (
      SELECT 1
      FROM public.stripe_charge_dispute_reinstatement_projections
        AS projection
      WHERE projection.livemode
        AND projection.stripe_event_id =
          'evt_reinstatement_first_tip'
        AND projection.result ->> 'status' = 'restored'
    )
  THEN
    RAISE EXCEPTION
      'reinstatement-first/dispute-first/payment-last order did not converge';
  END IF;

  BEGIN
    UPDATE public.stripe_charge_dispute_reinstatement_events
    SET captured_amount = captured_amount + 1
    WHERE livemode
      AND stripe_event_id = 'evt_reinstate_tip';
    RAISE EXCEPTION
      'reinstatement event audit ledger accepted mutation';
  EXCEPTION
    WHEN check_violation THEN
      NULL;
  END;

  v_readiness := public.stripe_paid_launch_readiness_v2();
  -- The shared harness deliberately carries unrelated legacy readiness debt.
  -- This proof owns only dispute/reinstatement and notification convergence.
  IF COALESCE(
      (v_readiness ->> 'unprojected_charge_disputes')::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'charge_dispute_identity_anomalies'
      )::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'charge_dispute_authority_drift'
      )::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'unprojected_dispute_reinstatements'
      )::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'dispute_reinstatement_identity_anomalies'
      )::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'dispute_reinstatement_authority_drift'
      )::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'notification_delivery_anomalies'
      )::integer,
      -1
    ) <> 0
  THEN
    RAISE EXCEPTION
      'Stripe dispute reinstatement readiness did not converge: %',
      v_readiness;
  END IF;
END
$prove_reinstatement_first_convergence$;

\echo 'Stripe dispute funds reinstatement fixture passed'
