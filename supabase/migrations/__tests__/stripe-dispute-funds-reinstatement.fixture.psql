DO $record_reinstatement_before_dispute$
DECLARE
  v_result jsonb;
BEGIN
  v_result :=
    public.record_stripe_charge_dispute_reinstatement_atomic(
      true,
      'evt_reinstatement_first_tip',
      1900000105,
      'dp_reinstatement_first_tip',
      'won',
      'fraudulent',
      900,
      'usd',
      'cus_reinstatement_first_tip',
      'pi_reinstatement_first_tip',
      'ch_reinstatement_first_tip',
      900,
      0
    );
  IF v_result IS DISTINCT FROM
    '{"status":"awaiting_dispute_created"}'::jsonb
  THEN
    RAISE EXCEPTION
      'reinstatement-first event was not durably accepted: %',
      v_result;
  END IF;

  v_result := public.record_api_tier_dispute_reversal_atomic(
    true,
    'evt_reinstatement_first_dispute',
    1900000106,
    'dp_reinstatement_first_tip',
    'warning_needs_response',
    'fraudulent',
    900,
    'usd',
    'cus_reinstatement_first_tip',
    'pi_reinstatement_first_tip',
    'ch_reinstatement_first_tip',
    900
  );
  IF v_result IS DISTINCT FROM '{"status":"not_api"}'::jsonb THEN
    RAISE EXCEPTION
      'reinstatement-first dispute was not durably accepted: %',
      v_result;
  END IF;
END
$record_reinstatement_before_dispute$;

