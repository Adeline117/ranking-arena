DO $funds_withdrawn_before_created_and_payment$
DECLARE
  v_result jsonb;
BEGIN
  v_result := public.record_api_tier_dispute_reversal_atomic(
    true,
    'evt_withdrawal_event_first',
    1900000310,
    'dp_withdrawal_event_first',
    'under_review',
    'fraudulent',
    700,
    'usd',
    'cus_withdrawal_event_first',
    'pi_withdrawal_event_first',
    'ch_withdrawal_event_first',
    700
  );
  IF v_result IS DISTINCT FROM '{"status":"not_api"}'::jsonb THEN
    RAISE EXCEPTION
      'funds-withdrawn-first event was not persisted: %',
      v_result;
  END IF;

  v_result := public.record_api_tier_dispute_reversal_atomic(
    true,
    'evt_withdrawal_created_late',
    1900000311,
    'dp_withdrawal_event_first',
    'needs_response',
    'fraudulent',
    700,
    'usd',
    'cus_withdrawal_event_first',
    'pi_withdrawal_event_first',
    'ch_withdrawal_event_first',
    700
  );
  IF v_result IS DISTINCT FROM
      '{"status":"already_withdrawn"}'::jsonb
  THEN
    RAISE EXCEPTION
      'late created event did not converge on withdrawn funds: %',
      v_result;
  END IF;
END
$funds_withdrawn_before_created_and_payment$;

