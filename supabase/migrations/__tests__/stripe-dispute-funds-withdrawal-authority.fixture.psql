);

DO $prove_deferred_projection_and_readiness$
DECLARE
  v_readiness jsonb;
BEGIN
  IF NOT EXISTS (
      SELECT 1
      FROM public.tips AS tip
      WHERE tip.id =
          'e7320000-0000-4000-8000-000000000002'
        AND tip.status = 'refunded'
    )
    OR (
      SELECT pg_catalog.count(*)
      FROM public.stripe_charge_dispute_events AS dispute
      WHERE dispute.stripe_dispute_id =
        'dp_withdrawal_event_first'
    ) <> 1
    OR (
      SELECT pg_catalog.count(*)
      FROM public.stripe_charge_dispute_projections AS projection
      WHERE projection.stripe_event_id =
        'evt_withdrawal_event_first'
    ) <> 1
  THEN
    RAISE EXCEPTION
      'funds-withdrawn-first deferred projection did not converge';
  END IF;

  v_readiness := public.stripe_paid_launch_readiness_v2();
  IF COALESCE(
      (v_readiness ->> 'unprojected_charge_disputes')::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'charge_dispute_identity_anomalies'
      )::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'charge_dispute_authority_drift'
      )::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'unprojected_dispute_reinstatements'
      )::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'dispute_reinstatement_identity_anomalies'
      )::integer,
      -1
    ) <> 0
    OR COALESCE(
      (
        v_readiness
          ->> 'dispute_reinstatement_authority_drift'
      )::integer,
      -1
    ) <> 0
  THEN
    RAISE EXCEPTION
      'funds-withdrawal readiness did not converge: %',
      v_readiness;
  END IF;
END
$prove_deferred_projection_and_readiness$;

DO $conflicting_replay_enters_manual_review$
DECLARE
  v_result jsonb;
BEGIN
  v_result := public.record_api_tier_dispute_reversal_atomic(
    true,
    'evt_withdrawal_conflict',
    1900000312,
    'dp_withdrawal_event_first',
    'lost',
    'duplicate',
    700,
    'usd',
    'cus_withdrawal_event_first',
    'pi_withdrawal_event_first',
    'ch_withdrawal_event_first',
    700
  );
  IF v_result IS DISTINCT FROM
      '{"status":"identity_conflict"}'::jsonb
    OR NOT EXISTS (
      SELECT 1
      FROM public.stripe_manual_reviews AS review
      WHERE review.object_type = 'dispute'
        AND review.object_id =
          'dp_withdrawal_event_first'
        AND review.reason_key =
          'stripe_dispute_withdrawal_identity_conflict'
        AND review.state = 'open'
    )
  THEN
    RAISE EXCEPTION
      'conflicting withdrawal replay escaped manual review: %',
      v_result;
  END IF;
END
$conflicting_replay_enters_manual_review$;

\echo 'Stripe dispute funds-withdrawal authority fixture passed'
