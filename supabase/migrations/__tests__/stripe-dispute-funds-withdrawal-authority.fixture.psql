DO $reject_warning_inquiry$
BEGIN
  BEGIN
    PERFORM public.record_api_tier_dispute_reversal_atomic(
      true,
      'evt_withdrawal_warning',
      1900000300,
      'dp_withdrawal_warning',
      'warning_needs_response',
      'fraudulent',
      500,
      'usd',
      'cus_withdrawal_payment_first',
      'pi_withdrawal_warning',
      'ch_withdrawal_warning',
      500
    );
    RAISE EXCEPTION
      'warning inquiry was accepted as financial reversal authority';
  EXCEPTION
    WHEN SQLSTATE '22023' THEN
      NULL;
  END;

  IF EXISTS (
    SELECT 1
    FROM public.stripe_charge_dispute_events AS dispute
    WHERE dispute.stripe_dispute_id =
      'dp_withdrawal_warning'
  ) THEN
    RAISE EXCEPTION
      'warning inquiry reached the immutable dispute ledger';
  END IF;
END
$reject_warning_inquiry$;

