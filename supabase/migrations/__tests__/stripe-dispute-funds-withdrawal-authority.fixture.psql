DO $created_then_withdrawn_replays$
DECLARE
  v_result jsonb;
  v_ownership_id uuid;
BEGIN
  v_result := public.record_api_tier_dispute_reversal_atomic(
    true,
    'evt_withdrawal_created_first',
    1900000301,
    'dp_withdrawal_first',
    'needs_response',
    'fraudulent',
    500,
    'usd',
    'cus_withdrawal_payment_first',
    'pi_withdrawal_payment_first',
    'ch_withdrawal_payment_first',
    500
  );
  IF v_result IS DISTINCT FROM '{"status":"not_api"}'::jsonb THEN
    RAISE EXCEPTION
      'first active dispute did not project exactly: %',
      v_result;
  END IF;

  v_result := public.record_api_tier_dispute_reversal_atomic(
    true,
    'evt_withdrawal_funds_second',
    1900000302,
    'dp_withdrawal_first',
    'under_review',
    'fraudulent',
    500,
    'usd',
    'cus_withdrawal_payment_first',
    'pi_withdrawal_payment_first',
    'ch_withdrawal_payment_first',
    500
  );
  IF v_result IS DISTINCT FROM
      '{"status":"already_withdrawn"}'::jsonb
  THEN
    RAISE EXCEPTION
      'funds_withdrawn replay was not acknowledged exactly: %',
      v_result;
  END IF;

  v_result := public.record_api_tier_dispute_reversal_atomic(
    true,
    'evt_withdrawal_created_third',
    1900000303,
    'dp_withdrawal_first',
    'lost',
    'fraudulent',
    500,
    'usd',
    'cus_withdrawal_payment_first',
    'pi_withdrawal_payment_first',
    'ch_withdrawal_payment_first',
    500
  );
  IF v_result IS DISTINCT FROM
      '{"status":"already_withdrawn"}'::jsonb
  THEN
    RAISE EXCEPTION
      'created replay after funds withdrawal did not converge: %',
      v_result;
  END IF;

  SELECT ownership.id
  INTO STRICT v_ownership_id
  FROM public.stripe_payment_ownerships AS ownership
  WHERE ownership.stripe_charge_id =
    'ch_withdrawal_payment_first';

  IF (
      SELECT pg_catalog.count(*)
      FROM public.stripe_charge_dispute_events AS dispute
      WHERE dispute.stripe_dispute_id =
        'dp_withdrawal_first'
    ) <> 1
    OR (
      SELECT pg_catalog.count(*)
      FROM public.stripe_charge_dispute_projections AS projection
      WHERE projection.ownership_id = v_ownership_id
        AND projection.stripe_event_id =
          'evt_withdrawal_created_first'
    ) <> 1
    OR NOT public.stripe_payment_ownership_has_active_dispute_v3(
      v_ownership_id
    )
    OR NOT EXISTS (
      SELECT 1
      FROM public.tips AS tip
      WHERE tip.id =
          'e7320000-0000-4000-8000-000000000001'
        AND tip.status = 'refunded'
    )
  THEN
    RAISE EXCEPTION
      'created/funds_withdrawn replay duplicated or lost reversal authority';
  END IF;
END
$created_then_withdrawn_replays$;

-- A second active dispute on the same payment must remain independent. Winning
-- only the first dispute cannot restore access; winning the final dispute can.
DO $multiple_disputes_remain_independent$
DECLARE
  v_result jsonb;
  v_ownership_id uuid;
BEGIN
  v_result := public.record_api_tier_dispute_reversal_atomic(
    true,
    'evt_withdrawal_second_dispute',
    1900000304,
    'dp_withdrawal_second',
    'needs_response',
    'duplicate',
    500,
    'usd',
    'cus_withdrawal_payment_first',
    'pi_withdrawal_payment_first',
    'ch_withdrawal_payment_first',
    500
  );
  IF v_result IS DISTINCT FROM '{"status":"not_api"}'::jsonb THEN
    RAISE EXCEPTION
      'second active dispute did not project exactly: %',
      v_result;
  END IF;

  v_result :=
    public.record_stripe_charge_dispute_reinstatement_atomic(
      true,
      'evt_withdrawal_first_won',
      1900000305,
      'dp_withdrawal_first',
      'won',
      'fraudulent',
      500,
      'usd',
      'cus_withdrawal_payment_first',
      'pi_withdrawal_payment_first',
      'ch_withdrawal_payment_first',
      500,
      0
    );
  IF v_result IS DISTINCT FROM
      '{"status":"refund_preserved"}'::jsonb
    OR NOT EXISTS (
      SELECT 1
      FROM public.stripe_charge_dispute_reinstatement_projections
        AS projection
      WHERE projection.stripe_event_id =
          'evt_withdrawal_first_won'
        AND projection.result ->> 'reason' =
          'other_dispute_active'
        AND projection.result ->> 'access_restored' =
          'false'
    )
    OR NOT EXISTS (
      SELECT 1
      FROM public.tips AS tip
      WHERE tip.id =
          'e7320000-0000-4000-8000-000000000001'
        AND tip.status = 'refunded'
    )
  THEN
    RAISE EXCEPTION
      'winning one of multiple disputes restored paid access: %',
      v_result;
  END IF;

  v_result :=
    public.record_stripe_charge_dispute_reinstatement_atomic(
      true,
      'evt_withdrawal_second_won',
      1900000306,
      'dp_withdrawal_second',
      'won',
      'duplicate',
      500,
      'usd',
      'cus_withdrawal_payment_first',
      'pi_withdrawal_payment_first',
      'ch_withdrawal_payment_first',
      500,
      0
    );
  IF v_result IS DISTINCT FROM '{"status":"restored"}'::jsonb
    OR NOT EXISTS (
      SELECT 1
      FROM public.tips AS tip
      WHERE tip.id =
          'e7320000-0000-4000-8000-000000000001'
        AND tip.status = 'completed'
    )
  THEN
    RAISE EXCEPTION
      'final won dispute did not restore exact paid access: %',
      v_result;
  END IF;

  SELECT ownership.id
  INTO STRICT v_ownership_id
  FROM public.stripe_payment_ownerships AS ownership
  WHERE ownership.stripe_charge_id =
    'ch_withdrawal_payment_first';
  IF public.stripe_payment_ownership_has_active_dispute_v3(
    v_ownership_id
  ) THEN
    RAISE EXCEPTION
      'fully reinstated payment retained active dispute authority';
  END IF;
END
$multiple_disputes_remain_independent$;

