DO $prove_api_tier_payment_reversal_schema$
DECLARE
  v_readiness jsonb;
  v_keys text[];
BEGIN
  PERFORM pg_catalog.set_config(
    'request.jwt.claim.role',
    'service_role',
    true
  );

  v_readiness := public.stripe_paid_launch_readiness_v2();
  SELECT pg_catalog.array_agg(key ORDER BY key)
  INTO v_keys
  FROM pg_catalog.jsonb_object_keys(v_readiness) AS key;

  IF v_keys IS DISTINCT FROM ARRAY[
    'api_tier_payment_backfill_incomplete',
    'api_tier_payment_ownership_anomalies',
    'api_tier_reversal_actions_incomplete',
    'authority_drift',
    'completed_effects_without_external_ref',
    'notification_delivery_anomalies',
    'open_manual_reviews',
    'paid_unbound_payments',
    'projection_drift',
    'reservation_anomalies',
    'status',
    'unfinished_effects',
    'unresolved_refund_tombstones'
  ]::text[]
  THEN
    RAISE EXCEPTION 'readiness JSON keys drifted: %', v_keys;
  END IF;

  RAISE NOTICE 'API tier payment reversal schema fixture passed';
END
$prove_api_tier_payment_reversal_schema$;

DO $prove_api_tier_payment_and_full_refund_stickiness$
DECLARE
  v_user_id uuid := '91000000-0000-4000-8000-000000000001';
  v_reservation jsonb;
  v_reservation_id uuid;
  v_checkout_expires_at bigint;
  v_result jsonb;
  v_status text;
  v_claim jsonb;
  v_action_id uuid;
  v_worker_token uuid := '91000000-0000-4000-8000-000000000002';
BEGIN
  PERFORM pg_catalog.set_config(
    'request.jwt.claim.role',
    'service_role',
    true
  );

  INSERT INTO auth.users(id) VALUES (v_user_id);
  INSERT INTO public.user_profiles (
    id,
    subscription_tier,
    is_pro,
    stripe_customer_id,
    api_tier,
    updated_at
  ) VALUES (
    v_user_id,
    'free',
    false,
    'cus_api_reversal',
    'free',
    pg_catalog.clock_timestamp()
  );
  INSERT INTO public.api_keys (
    id,
    user_id,
    key,
    name
  ) VALUES (
    '91000000-0000-4000-8000-000000000003',
    v_user_id,
    'arena_sk_91000000000040008000000000000003',
    'reversal-proof'
  );

  v_reservation := public.reserve_api_tier_checkout_atomic(
    v_user_id,
    true,
    'cus_api_reversal',
    'starter',
    'price_api_reversal'
  );
  v_reservation_id := (v_reservation ->> 'reservation_id')::uuid;
  v_checkout_expires_at :=
    (v_reservation ->> 'checkout_expires_at')::bigint;
  IF v_reservation ->> 'status' <> 'reserved'
    OR v_reservation_id IS NULL
  THEN
    RAISE EXCEPTION 'API payment reservation failed: %', v_reservation;
  END IF;

  v_result := public.bind_api_tier_checkout_session_atomic(
    v_reservation_id,
    v_user_id,
    true,
    'cus_api_reversal',
    'starter',
    'price_api_reversal',
    'cs_api_reversal',
    v_checkout_expires_at
  );
  IF v_result ->> 'status' <> 'bound' THEN
    RAISE EXCEPTION 'API payment Checkout binding failed: %', v_result;
  END IF;

  v_status := public.apply_user_api_tier_stripe_event(
    v_user_id,
    v_user_id,
    v_user_id,
    'cus_api_reversal',
    v_reservation_id,
    'price_api_reversal',
    'starter',
    10000,
    'sub_api_reversal',
    2000000000,
    'evt_api_subscription_active',
    2000000001,
    true,
    false,
    true,
    'cs_api_reversal',
    'starter',
    'price_api_reversal',
    'signed_metadata'
  );
  IF v_status <> 'applied' THEN
    RAISE EXCEPTION 'sealed API subscription authority failed: %', v_status;
  END IF;

  v_result := public.record_api_tier_payment_atomic(
    v_user_id,
    true,
    'cus_api_reversal',
    v_reservation_id,
    'sub_api_reversal',
    'in_api_reversal',
    'inpay_api_reversal',
    'pi_api_reversal',
    'ch_api_reversal',
    'price_api_reversal',
    'starter',
    4900,
    'usd',
    2000000000,
    2002592000,
    2000000010,
    2000000020,
    'evt_api_invoice_paid',
    2000000030,
    'invoice.paid'
  );
  IF v_result ->> 'status' <> 'recorded'
    OR v_result ->> 'projection_status' IS NULL
    OR (v_result ->> 'should_cancel')::boolean
    OR (
      SELECT pg_catalog.count(*)
      FROM public.stripe_api_tier_payments AS payment
      JOIN public.stripe_payment_ownerships AS ownership
        ON ownership.product_kind = 'api_tier'
       AND ownership.ledger_id = payment.id
      WHERE payment.stripe_invoice_id = 'in_api_reversal'
        AND public.stripe_payment_ownership_is_exact_v2(ownership.id)
    ) <> 1
  THEN
    RAISE EXCEPTION 'API payment was not recorded exactly once: %', v_result;
  END IF;

  v_result := public.record_api_tier_payment_atomic(
    v_user_id,
    true,
    'cus_api_reversal',
    v_reservation_id,
    'sub_api_reversal',
    'in_api_reversal',
    'inpay_api_reversal',
    'pi_api_reversal',
    'ch_api_reversal',
    'price_api_reversal',
    'starter',
    4900,
    'usd',
    2000000000,
    2002592000,
    2000000010,
    2000000020,
    'evt_api_invoice_paid',
    2000000030,
    'invoice.paid'
  );
  IF v_result ->> 'status' <> 'already_recorded'
    OR (
      SELECT pg_catalog.count(*)
      FROM public.stripe_api_tier_payments
      WHERE stripe_invoice_id = 'in_api_reversal'
    ) <> 1
  THEN
    RAISE EXCEPTION 'API payment replay was not idempotent: %', v_result;
  END IF;

  -- A cross-mode dispute cannot touch the live payment or create a reversal.
  v_result := public.record_api_tier_dispute_reversal_atomic(
    false,
    'evt_api_wrong_mode_dispute',
    2000000040,
    'dp_api_wrong_mode',
    'needs_response',
    'fraudulent',
    4900,
    'usd',
    'cus_api_reversal',
    'pi_api_reversal',
    'ch_api_reversal',
    4900
  );
  IF v_result ->> 'status' <> 'identity_conflict'
    OR EXISTS (
      SELECT 1
      FROM public.stripe_api_tier_reversal_events
      WHERE stripe_event_id = 'evt_api_wrong_mode_dispute'
    )
  THEN
    RAISE EXCEPTION 'cross-mode API dispute mutated authority: %', v_result;
  END IF;

  v_result := public.record_charge_refund_tombstone_with_mode_atomic(
    true,
    v_user_id,
    'cus_api_reversal',
    'pi_api_reversal',
    'ch_api_reversal',
    true,
    4900,
    'usd',
    4900,
    'succeeded',
    'evt_api_full_refund',
    '2033-05-18 03:34:10+00'::timestamptz
  );
  IF v_result ->> 'product_kind' <> 'api_tier'
    OR v_result ->> 'projection_status' <> 'revoked'
    OR NOT (v_result ->> 'api_tier_should_cancel')::boolean
    OR NOT EXISTS (
      SELECT 1
      FROM public.api_tier_subscription_blocks
      WHERE livemode
        AND stripe_subscription_id = 'sub_api_reversal'
        AND block_kind = 'financial_reversal'
        AND user_id = v_user_id
    )
    OR NOT EXISTS (
      SELECT 1
      FROM public.user_profiles
      WHERE id = v_user_id
        AND api_tier = 'free'
        AND api_stripe_subscription_id IS NULL
    )
    OR NOT EXISTS (
      SELECT 1
      FROM public.api_keys
      WHERE user_id = v_user_id
        AND NOT active
        AND tier = 'free'
        AND daily_limit = 100
        AND revoked_at IS NOT NULL
    )
  THEN
    RAISE EXCEPTION 'full API refund did not revoke sticky authority: %', v_result;
  END IF;

  -- A later active event from the same refunded subscription is blocked.
  v_status := public.apply_user_api_tier_stripe_event(
    v_user_id,
    v_user_id,
    v_user_id,
    'cus_api_reversal',
    v_reservation_id,
    'price_api_reversal',
    'starter',
    10000,
    'sub_api_reversal',
    2000000000,
    'evt_api_impossible_revival',
    2000000050,
    true,
    false,
    true,
    'cs_api_reversal',
    'starter',
    'price_api_reversal',
    'signed_metadata'
  );
  IF v_status <> 'blocked'
    OR NOT EXISTS (
      SELECT 1
      FROM public.user_profiles
      WHERE id = v_user_id
        AND api_tier = 'free'
        AND api_stripe_subscription_id IS NULL
    )
  THEN
    RAISE EXCEPTION 'full-refunded API subscription revived: %', v_status;
  END IF;

  v_claim := public.claim_api_tier_reversal_actions_atomic(
    v_worker_token,
    1,
    60,
    true
  );
  v_action_id := (v_claim -> 0 ->> 'id')::uuid;
  IF pg_catalog.jsonb_array_length(v_claim) <> 1
    OR v_action_id IS NULL
    OR v_claim -> 0 ->> 'stripe_subscription_id' <>
      'sub_api_reversal'
  THEN
    RAISE EXCEPTION 'refund cancellation action was not leaseable: %', v_claim;
  END IF;

  v_status := public.finish_api_tier_reversal_action_atomic(
    v_action_id,
    v_worker_token,
    true,
    'canceled',
    NULL,
    NULL
  );
  IF v_status <> 'completed'
    OR NOT public.stripe_refund_tombstone_is_resolved_v2(
      'ch_api_reversal'
    )
    OR (
      public.stripe_paid_launch_readiness_v2()
        ->> 'api_tier_reversal_actions_incomplete'
    )::integer <> 0
  THEN
    RAISE EXCEPTION 'refund cancellation completion was not durable: %', v_status;
  END IF;

  RAISE NOTICE 'API tier exact payment/full-refund stickiness fixture passed';
END
$prove_api_tier_payment_and_full_refund_stickiness$;

DO $prove_recurring_pro_refund_cannot_be_revived$
DECLARE
  v_user_id uuid := '92000000-0000-4000-8000-000000000001';
  v_customer_id text :=
    'cus_92000000000040008000000000000001';
  v_result jsonb;
  v_status text;
  v_refunded_payment_id uuid;
  v_replacement_payment_id uuid;
BEGIN
  PERFORM pg_catalog.set_config(
    'request.jwt.claim.role',
    'service_role',
    true
  );

  INSERT INTO auth.users(id) VALUES (v_user_id);
  INSERT INTO public.user_profiles (
    id,
    subscription_tier,
    is_pro,
    stripe_customer_id,
    updated_at
  ) VALUES (
    v_user_id,
    'free',
    false,
    v_customer_id,
    pg_catalog.clock_timestamp()
  );

  v_result := public.test_activate_recurring(
    v_user_id,
    'sub_pro_refund_sticky',
    'pro_refund_sticky_first',
    '2034-01-01Z',
    '2034-02-01Z'
  );
  IF v_result ->> 'status' <> 'activated' THEN
    RAISE EXCEPTION 'recurring Pro setup activation failed: %', v_result;
  END IF;

  SELECT subscription.entitlement_payment_id
  INTO v_refunded_payment_id
  FROM public.subscriptions AS subscription
  WHERE subscription.user_id = v_user_id;

  v_result := public.test_refund_recurring(
    v_user_id,
    'sub_pro_refund_sticky',
    'pro_refund_sticky_first',
    1000,
    'succeeded',
    'active',
    'evt_pro_refund_sticky',
    '2034-01-02Z',
    '2034-01-01Z',
    '2034-02-01Z'
  );
  IF v_result ->> 'status' <> 'revoked' THEN
    RAISE EXCEPTION 'recurring Pro full refund did not revoke: %', v_result;
  END IF;

  v_status :=
    public.sync_recurring_pro_subscription_projection_atomic(
      v_user_id,
      'active',
      'sub_pro_refund_sticky',
      v_customer_id,
      'monthly',
      '2034-01-01Z',
      '2034-02-01Z',
      false
    );
  IF v_status <> 'blocked_full_refund'
    OR NOT EXISTS (
      SELECT 1
      FROM public.subscriptions
      WHERE user_id = v_user_id
        AND status = 'canceled'
        AND entitlement_payment_id = v_refunded_payment_id
    )
    OR NOT EXISTS (
      SELECT 1
      FROM public.user_profiles
      WHERE id = v_user_id
        AND subscription_tier = 'free'
        AND NOT is_pro
    )
  THEN
    RAISE EXCEPTION 'Stripe-active sync revived refunded Pro: %', v_status;
  END IF;

  -- Only a later exact paid period may replace the refunded binding.
  v_result := public.test_activate_recurring(
    v_user_id,
    'sub_pro_refund_sticky',
    'pro_refund_sticky_second',
    '2034-02-01Z',
    '2034-03-01Z'
  );
  IF v_result ->> 'status' <> 'activated' THEN
    RAISE EXCEPTION 'later recurring Pro payment did not activate: %', v_result;
  END IF;
  SELECT subscription.entitlement_payment_id
  INTO v_replacement_payment_id
  FROM public.subscriptions AS subscription
  WHERE subscription.user_id = v_user_id;
  IF v_replacement_payment_id IS NULL
    OR v_replacement_payment_id = v_refunded_payment_id
  THEN
    RAISE EXCEPTION 'later Pro payment did not replace exact binding';
  END IF;

  v_status :=
    public.sync_recurring_pro_subscription_projection_atomic(
      v_user_id,
      'active',
      'sub_pro_refund_sticky',
      v_customer_id,
      'monthly',
      '2034-02-01Z',
      '2034-03-01Z',
      false
    );
  IF v_status <> 'updated'
    OR NOT EXISTS (
      SELECT 1
      FROM public.subscriptions
      WHERE user_id = v_user_id
        AND status = 'active'
        AND entitlement_payment_id = v_replacement_payment_id
    )
    OR NOT EXISTS (
      SELECT 1
      FROM public.user_profiles
      WHERE id = v_user_id
        AND subscription_tier = 'pro'
        AND is_pro
    )
  THEN
    RAISE EXCEPTION 'later exact paid period did not restore Pro: %', v_status;
  END IF;

  RAISE NOTICE 'recurring Pro refund revival fence fixture passed';
END
$prove_recurring_pro_refund_cannot_be_revived$;
