    "qa:api-auth": "node scripts/qa/api-auth-coverage-check.mjs",
    "qa:architecture": "node scripts/qa/architecture-boundary-check.mjs",
    "qa:migrations": "node scripts/qa/check-migration-ledger.mjs",
    "qa:migration-safety": "node scripts/qa/migration-sql-safety-check.mjs",
    "qa:migration-history-shape": "node scripts/qa/migration-history-shape.mjs",
    "qa:baseline-candidate": "node scripts/qa/validate-baseline-candidate.mjs",
    "qa:baseline-candidates": "node scripts/qa/validate-baseline-candidate.mjs --all",
    "qa:baseline-candidate-assemble": "node scripts/maintenance/assemble-canonical-baseline-candidate.mjs",
    "qa:baseline-candidate-assembler-contract": "node --test scripts/qa/canonical-baseline-candidate-assembler.test.mjs",
    "qa:baseline-capture": "node --test scripts/qa/canonical-baseline-capture.test.mjs",
