# Worker env — copy to worker/.env and fill in values

# Native Redis TCP connection (NOT the REST API)
# Get from: Upstash Dashboard → your database → Connect → ioredis
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379

# Supabase (same as main app)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Direct Postgres session-pooler connection used by both worker startup gates
# and ingestion writes. Persistent workers must use port 5432, never the
# transaction pooler on 6543.
INGEST_DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres

# Required stable production topology identity. Preserve the logical ID already
# present in Redis when migrating an existing node; changing it creates a
# temporary second owner. Mac example: local + local. SG example:
# vps_sg + vps_sg.
WORKER_NODE_ID=stable-logical-node-id
INGEST_REGIONS=local
INGEST_LOCAL_REGION=local

# Required by the release-readiness gate. Keep identical on both worker nodes.
INGEST_ATTEMPT_BOUND_CAPTURE_ENABLED=true

# Optional fleet-wide scheduler switch. Change both nodes together or leave 0.
INGEST_FAST_LANE=0

# Optional: VPS proxy for geo-blocked APIs
# VPS_PROXY_URL=
# VPS_PROXY_KEY=
